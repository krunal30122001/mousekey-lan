{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MouseKey LAN",
  "version": "0.3.2",
  "identifier": "com.mousekeylan.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "MouseKey LAN",
        "width": 1120,
        "height": 740,
        "minWidth": 880,
        "minHeight": 580,
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "MouseKey LAN",
    "shortDescription": "Share one keyboard and mouse across PCs on your LAN",
    "longDescription": "MouseKey LAN lets you control multiple computers on the same network with a single keyboard and mouse. Move the cursor across screen edges to switch computers.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": {
      "../target/release/mkl-service.exe": "."
    },
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "installerHooks": "./windows/hooks.nsh"
      }
    }
  }
}
